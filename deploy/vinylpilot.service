[Unit]
Description=VinylPilot – USB turntable streamer for Music Assistant
Documentation=https://github.com/Mgns55/VinylPilot
Wants=network-online.target
After=network-online.target sound.target

[Service]
Type=simple
User=vinylpilot
Group=audio
EnvironmentFile=-/etc/default/vinylpilot
# Secrets (VINYLPILOT_MQTT_PASSWORD); root-only file, read by systemd before dropping privileges
EnvironmentFile=-/etc/vinylpilot/secrets.env
ExecStart=/opt/vinylpilot/.venv/bin/vinylpilot $VINYLPILOT_ARGS
Environment=PYTHONUNBUFFERED=1
# Identity and pairing live in /var/lib/vinylpilot (STATE_DIRECTORY)
StateDirectory=vinylpilot
StateDirectoryMode=0700
Restart=always
RestartSec=5
# Stop signal goes to the main process only; it lets the recorder process finish the
# current track (<= 10 s) before everything is stopped. Never wait 90 s.
KillMode=mixed
TimeoutStopSec=25
# Audio first: slightly higher CPU and I/O priority than normal processes
Nice=-5
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# recordings (Synology share mounted by scripts/setup-nas.sh); '-' = may not exist
ReadWritePaths=-/mnt/vinylpilot

[Install]
WantedBy=multi-user.target
